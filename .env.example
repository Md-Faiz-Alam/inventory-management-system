DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Extra origins allowed to POST forms, e.g. https://inventory.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local PostgreSQL (compose.yaml). Ignored when DATABASE_URL is set.
POSTGRES_DB=inventory
POSTGRES_USER=inventory_dev
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Production database, e.g. Neon:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Demo accounts created by `python manage.py bootstrap_demo` (leave blank to skip).
DEMO_MODE=false
# One-click read-only guest button (defaults to DEMO_MODE).
GUEST_ACCESS=
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_STAFF_PASSWORD=

# Optional superuser for /admin/, created once by bootstrap_demo.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Shown on invoices and purchase orders.
COMPANY_NAME=StockFlow Demo Traders
COMPANY_ADDRESS=Bengaluru, Karnataka, India
COMPANY_GSTIN=
COMPANY_EMAIL=
COMPANY_PHONE=
